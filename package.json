{
  "name": "ngina-trails-safaris",
  "version": "0.1.0",
  "private": true,
  "description": "Ngina Trails & Safaris (Diani Beach, Kenya): public website and back-office, Next.js + Payload CMS",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "brand": "python3 -I scripts/brand/sample-colours.py && python3 -I scripts/brand/segment.py && node scripts/brand/trace.mjs",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@vercel/analytics": "1.5.0",
    "cross-env": "^10.1.0",
    "graphql": "^16.15.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "payload": "3.93.0",
    "pdf-lib": "^1.17.1",
    "postmark": "^5.1.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "potrace": "^2.1.8",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
