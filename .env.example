# ─────────────────────────────────────────────────────────────────────────────
# Ngina Trails & Safaris: environment variables
# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Only the first block is required;
# everything else switches a feature on (the app runs without it).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
# Public address of the site, no trailing slash (used in emails, sitemap, SEO).
# On Vercel it defaults to the project's production domain; set it once you use your own domain.
SITE_URL=http://localhost:3000
# Postgres connection string. Easiest: Vercel → Storage → Neon (sets DATABASE_URL / POSTGRES_URL for you).
DATABASE_URL=postgres://ngina:ngina@localhost:5432/ngina
# Long random string that signs logins. Generate: openssl rand -hex 32
# Optional on Vercel: if blank, one is derived from the database URL.
PAYLOAD_SECRET=
# Switches on the daily job (quote expiry, balance and eTA reminders, trip status, review requests).
# Vercel Cron sends it automatically. Any long random text, e.g. openssl rand -hex 24
CRON_SECRET=

# ── Photo & video storage: Vercel Blob (simplest) ──────────────────────────
# Vercel → Storage → Blob → Connect: sets this automatically.
BLOB_READ_WRITE_TOKEN=

# ── …or Cloudflare R2 (S3-compatible; used instead of Blob when set) ───────
# Without these, uploads are stored on the server's disk (fine for dev / a VPS
# with a volume, NOT for Vercel).
S3_BUCKET=
S3_ENDPOINT=            # https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=          # public bucket URL or custom domain, e.g. https://media.example.com

# ── Email: Postmark ────────────────────────────────────────────────────────
# Without these, emails are written to the server log instead of being sent.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=    # a verified sender, e.g. "Ngina Trails & Safaris <hello@yourdomain>"
POSTMARK_MESSAGE_STREAM=outbound
# Inbound (guest replies thread into the admin inbox):
POSTMARK_INBOUND_ADDRESS=          # e.g. abc123@inbound.postmarkapp.com
POSTMARK_INBOUND_WEBHOOK_USER=     # any username; also put it in the Postmark webhook URL
POSTMARK_INBOUND_WEBHOOK_PASSWORD= # long random password

# ── Live chat real-time: Pusher OR Ably (optional; chat polls without) ─────
REALTIME_PROVIDER=      # pusher | ably | none (auto-detected if blank)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
ABLY_API_KEY=

# ── Payments: Paystack (M-Pesa + cards) ────────────────────────────────────
PAYSTACK_SECRET_KEY=    # sk_live_… (sk_test_… for testing)
PAYSTACK_PUBLIC_KEY=    # pk_live_…
PAYMENT_CURRENCY=KES    # default charge currency; M-Pesa needs KES

# ── Spam protection: Cloudflare Turnstile (optional) ───────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ENQUIRY_RATE_LIMIT=5    # enquiries per IP per 10 minutes

# ── Search engines (optional) ──────────────────────────────────────────────
INDEXNOW_KEY=           # any 32-character hex string; notifies Bing etc. on publish

# ── Docker Compose only ────────────────────────────────────────────────────
POSTGRES_PASSWORD=      # password for the bundled Postgres. Generate: openssl rand -hex 24

# ── Setup script (pnpm seed) ───────────────────────────────────────────────
# Leave passwords blank to have strong random ones generated and printed once.
SEED_ADMIN_EMAIL=admin@ngina.local
SEED_ADMIN_PASSWORD=
SEED_SALES_PASSWORD=
SEED_EDITOR_PASSWORD=

# Optional, also settable in the admin (Integrations). Values here take priority.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_CLARITY_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
